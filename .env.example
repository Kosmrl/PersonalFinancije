# Copy to .env.local and adjust. Never commit .env.local.
# Read by Next.js (dev, build) and by the npm scripts db, mail, db:* (node --env-file-if-exists).
# Consumed by src/server/env.ts from build-sequence step 2 onward.

APP_NAME=PersonalFinancije

# --- Local PostgreSQL (npm run db) ------------------------------------------------------
# DEV-ONLY passwords for the project-local database (.data/postgres, 127.0.0.1 only).
# Never reuse them anywhere else. `npm run db` applies pf_owner and pf_app on every start, so
# changing them here takes effect at the next start. PG_SUPERUSER_PASSWORD is fixed when the
# cluster is created: to change it, stop `npm run db`, delete .data/postgres and start again.
DB_PORT=5433
PG_SUPERUSER_PASSWORD=dev-only-postgres
PF_OWNER_PASSWORD=dev-only-pf-owner
PF_APP_PASSWORD=dev-only-pf-app

# Runtime role pf_app (NOSUPERUSER NOBYPASSRLS, owns nothing) and migration role pf_owner
# (schema owner). Keep the port and passwords in step with the block above.
DATABASE_URL=postgres://pf_app:dev-only-pf-app@127.0.0.1:5433/pf_dev
DATABASE_MIGRATION_URL=postgres://pf_owner:dev-only-pf-owner@127.0.0.1:5433/pf_dev

# --- Auth (required from build-sequence step 4) -------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3000

# --- Local mail catcher (npm run mail): SMTP on 1025, web UI and HTTP API on 1080 ---------
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="PersonalFinancije <no-reply@example.test>"
MAIL_HTTP_PORT=1080

# --- Playwright ---------------------------------------------------------------------------
PLAYWRIGHT_BASE_URL=http://localhost:3000
